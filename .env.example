APP_NAME=Pentahoot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Host port of the app container (compose.yaml). Change it when 8000 is taken on this machine.
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# A9: MySQL server outside Docker. Inside the app container the host is
# host.docker.internal. Tests use DB_DATABASE=pentahoot_test (phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=pentahoot
DB_USERNAME=pentahoot
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# F5, F7: realtime through one Reverb server (A8: the reverb container).
# K6: web requests refuse to start while a REVERB_* value below is empty. Generate the app
# id, key and secret once per environment, e.g. `php -r "echo bin2hex(random_bytes(16));"`.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# How the app container reaches Reverb (compose service name, plain HTTP inside Docker).
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# How browsers reach Reverb. Locally the reverb container is published on this host port.
REVERB_CLIENT_HOST=localhost
REVERB_CLIENT_PORT=8080
REVERB_CLIENT_SCHEME=http
# Host names allowed to open a WebSocket, comma separated. Defaults to the APP_URL host.
# REVERB_ALLOWED_ORIGINS=localhost
FILESYSTEM_DISK=local
# F16: true only behind nginx with the internal /_media/ location (production); PHP sends private images otherwise.
MEDIA_ACCEL=false
# F7: no queue worker. Broadcasts use ShouldBroadcastNow.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Docker Compose only: absolute project path as the Docker engine sees it.
# Leave empty on Linux and macOS. Windows with a WSL engine: /mnt/c/path/to/pentahoot
PROJECT_PATH=
