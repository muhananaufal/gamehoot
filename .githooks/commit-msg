#!/bin/sh
# W4: Conventional Commits header, e.g. "feat(db): add events table".
set -eu

header=$(head -n 1 "$1")

case "$header" in
    "Merge branch "* | "Merge tag "* | "Revert \""*) exit 0 ;;
esac

if ! printf '%s\n' "$header" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^ ].{0,98}$'; then
    echo "commit-msg: header must follow Conventional Commits, max 100 characters:" >&2
    echo "  <type>(<scope>): <summary>   types: feat fix docs style refactor perf test build ci chore revert" >&2
    echo "  got: $header" >&2
    exit 1
fi
