# .env of a staging or production server (O3). Copy to the deploy folder as .env, fill in the
# [..] values and keep it only there: never in the repository. Generate APP_KEY with
#   docker run --rm ghcr.io/devivace-groups/pentahoot:<tag> php artisan key:generate --show
# and the Reverb id, key and secret with random values (different per environment).

APP_NAME=Pentahoot
APP_ENV=production
APP_DEBUG=false
APP_KEY=[base64:...]
APP_URL=https://[DOMAIN]
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# O7: the host's Caddy reaches the containers through the Docker network gateway.
TRUSTED_PROXIES=172.16.0.0/12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# A9: the existing MySQL server. host.docker.internal when it runs on this VM, otherwise
# its internal IP (allowed only from this VM).
DB_CONNECTION=mysql
DB_HOST=[host.docker.internal or internal IP]
DB_PORT=3306
DB_DATABASE=[pentahoot or pentahoot_staging]
DB_USERNAME=[user]
DB_PASSWORD=[password]
# O4: the MySQL client image that dumps the database before every migration (deploy.sh).
# Match the server's major version once it is known (O-B).
MYSQL_CLIENT_IMAGE=mysql:8.4

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# F16: nginx sends private images after Laravel checked the signature.
MEDIA_ACCEL=true

# How the app reaches Reverb inside Docker.
REVERB_APP_ID=[random]
REVERB_APP_KEY=[random]
REVERB_APP_SECRET=[random]
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=[DOMAIN]

# How browsers reach Reverb: through Caddy on 443.
REVERB_CLIENT_HOST=[DOMAIN]
REVERB_CLIENT_PORT=443
REVERB_CLIENT_SCHEME=https

# Host ports, bound to 127.0.0.1, that Caddy forwards to (deploy/compose.yaml).
WEB_PORT=8000
REVERB_HOST_PORT=8080
